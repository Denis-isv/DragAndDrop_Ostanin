<Page x:Class="DragAndDrop_Ostanin.CropPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Обрезка фото" Background="gray">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" 
                BorderBrush="Gray" BorderThickness="1" Background="#1E1E1E" Margin="0,0,10,0">
            <Grid ClipToBounds="True">
                <Image x:Name="image" Stretch="Uniform"
                       SizeChanged="Image_SizeChanged"
                       UseLayoutRounding="True"/>

                <Canvas x:Name="overlay" Background="Transparent"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                        MouseMove="Canvas_MouseMove"
                        MouseLeftButtonUp="Canvas_MouseLeftButtonUp"
                        MouseRightButtonDown="Canvas_MouseRightButtonDown">
                    <Border x:Name="cropRect" BorderBrush="White" BorderThickness="2"
                            Background="white" Visibility="Collapsed"/>
                </Canvas>
            </Grid>
        </Border>

        <StackPanel Grid.Row="0" Grid.Column="1" Width="200" Margin="10,0,0,0">
            <TextBlock Text="Размеры размер" Foreground="White" FontSize="14" Margin="0,0,0,10"/>
            <TextBlock x:Name="originalSize" Text="0 x 0" Foreground="Gray" FontSize="12" Margin="0,0,0,15"/>

            <TextBlock Text="В масштабе" Foreground="White" FontSize="14" Margin="0,0,0,10"/>
            <TextBlock x:Name="scaleSize" Text="0 x 0" Foreground="Gray" FontSize="12" Margin="0,0,0,15"/>

            <TextBlock Text="Получится на выходе" Foreground="White" FontSize="14" Margin="0,0,0,10"/>
            <TextBlock x:Name="outputSize" Text="0 x 0" Foreground="blue" FontSize="12" Margin="0,0,0,20"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" 
                    HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Click="LoadImageButton" Content="Загрузить" Width="100" Height="35" Margin="10" 
                    Background="pink" Foreground="White"/>
            <Button Click="ClearCrop" Content="Очистить" Width="100" Height="35" Margin="10" 
                    Background="black" Foreground="White"/>
            <Button Click="CropImage" Content="Обрезать" Width="100" Height="35" Margin="10" 
                    Background="green" Foreground="White"/>
            <Button Click="BackToMain" Content="Назад" Width="100" Height="35" Margin="10" 
                    Background="red" Foreground="White"/>
        </StackPanel>
    </Grid>
</Page>